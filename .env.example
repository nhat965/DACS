MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cosmetic_ecommerce
MYSQL_EXPECTED_PRICE_CURRENCY=USD
RECOMMENDATION_DB_ENABLED=false
RECOMMENDATION_CATALOG_PATH=
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_SECONDS=28800
# Optional bootstrap. The service creates this account as ADMIN only when all
# required values are present. Never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Lumi Administrator
# Comma-separated production frontend origins. When deploying the Flutter app
# and FastAPI as Vercel Services under one domain, this can stay blank because
# the browser uses same-origin /api requests. Localhost ports are allowed by
# CORS_ALLOW_ORIGIN_REGEX in development.
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
# Gemini is used only by the FastAPI backend. Never expose this key in Flutter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15
