MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cosmetic_ecommerce
# Optional alternative to the individual MYSQL_* connection values.
MYSQL_URL=
# Aiven MySQL uses TLS. In Vercel, paste the full CA certificate here (newlines
# or escaped \n are both accepted); the backend writes it to its temporary
# runtime storage only. Never expose MYSQL_URL or this value to Flutter.
MYSQL_SSL_CA_PEM=
# REQUIRED, VERIFY_CA, or VERIFY_IDENTITY. Use VERIFY_CA with MYSQL_SSL_CA_PEM.
MYSQL_SSL_MODE=
MYSQL_EXPECTED_PRICE_CURRENCY=USD
RECOMMENDATION_DB_ENABLED=false
RECOMMENDATION_CATALOG_PATH=
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_SECONDS=28800
# Optional bootstrap. The service creates this account as ADMIN only when all
# required values are present. Never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Lumi Administrator
# Comma-separated production frontend origins. For a Vercel frontend and
# Vercel FastAPI backend, use the Vercel URL here, for example
# https://lumi-beauty.vercel.app. Localhost ports remain allowed by
# CORS_ALLOW_ORIGIN_REGEX in development.
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
# Gemini is used only by the FastAPI backend. Never expose this key in Flutter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15
