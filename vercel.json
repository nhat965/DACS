{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "lumi_web": {
      "root": "apps/web",
      "buildCommand": "bash scripts/vercel_build.sh",
      "outputDirectory": "build/web"
    },
    "lumi_api": {
      "root": "services/recommendation-service",
      "framework": "fastapi",
      "entrypoint": "vercel_entry:app",
      "functions": {
        "**/*.py": {
          "maxDuration": 30,
          "excludeFiles": "{tests/**,evaluation/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "lumi_api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "lumi_web"
      }
    }
  ]
}
